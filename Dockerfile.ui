FROM python:3.11-slim

WORKDIR /app

# Build context is the PARENT directory of researcher_agent/, e.g.:
#   docker build -f researcher_agent/Dockerfile.ui -t research-ui .

COPY researcher_agent/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY researcher_agent /app/researcher_agent

ENV PYTHONPATH=/app

EXPOSE 8501

CMD ["streamlit", "run", "researcher_agent/app.py", "--server.address=0.0.0.0", "--server.port=8501"]
